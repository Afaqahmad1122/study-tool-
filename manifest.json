{
  "manifest_version": 3,
  "name": "Study Tools",
  "version": "0.1",
  "description": "Study helper extension",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": [
    "<all_urls>",
    "https://api.dictionaryapi.dev/*",
    "https://translate.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}